# OpenAI (generation). Without a key the app runs in offline mode with heuristic drafts.
OPENAI_API_KEY=
# CF_MODEL=gpt-6-astra
# CF_EFFORT=medium

# MeetStream: meeting links, bot ids and speaker-labelled transcripts. Optional: dropped files and
# recording links work without it. Create a key at https://app.meetstream.ai/api-key
MEETSTREAM_API_KEY=

# Optional: require `Authorization: Bearer <token>` on the API and dashboard
# CF_API_TOKEN=
# CF_DATA_DIR=data
