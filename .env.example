# OpenAI (generation). Without a key the app runs in offline mode with heuristic drafts.
OPENAI_API_KEY=
# CF_MODEL=gpt-6-astra
# CF_EFFORT=medium

# MeetStream (the only source of recordings and transcripts). Create a key at https://app.meetstream.ai/api-key
MEETSTREAM_API_KEY=

# Optional: require `Authorization: Bearer <token>` on the API and dashboard
# CF_API_TOKEN=
# CF_DATA_DIR=data
